    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Starts a study action with the moss accent.",
      "html": "<button type=\"button\" class=\"ds-btn-primary\">Tiếp tục</button>",
      "css": ".ds-btn-primary { background: var(--accent); color: var(--on-accent); padding: 10px 16px; border: 1px solid transparent; border-radius: var(--radius-control); font: 650 15px var(--sans); cursor: pointer; transition: background-color .14s ease-out, color .14s ease-out; } .ds-btn-primary:hover { filter: brightness(1.07); } .ds-btn-primary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; } .ds-btn-primary:active { filter: brightness(.96); }"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Keeps secondary navigation and utility actions quiet.",
      "html": "<button type=\"button\" class=\"ds-btn-ghost\">Đổi tông nền</button>",
      "css": ".ds-btn-ghost { background: transparent; color: var(--text); padding: 8px 10px; border: 1px solid transparent; border-radius: var(--radius-control); font: 650 13px var(--sans); cursor: pointer; transition: background-color .14s ease-out, color .14s ease-out; } .ds-btn-ghost:hover { background: var(--surface-2); } .ds-btn-ghost:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; } .ds-btn-ghost:active { background: var(--accent-soft); }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Filters a list while staying legible on the paper surface.",
      "html": "<label class=\"ds-field\"><span>Tìm lộ trình</span><input type=\"search\" placeholder=\"Ví dụ: React\"></label>",
      "css": ".ds-field { display: grid; gap: 6px; color: var(--muted); font: 400 14px/1.4 var(--sans); } .ds-field input { width: 100%; padding: 9px 12px; border: 1.5px solid var(--border); border-radius: var(--radius-lg); background: transparent; color: var(--text); font: 400 16px/1.5 var(--sans); } .ds-field input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-color: var(--accent); }"
    },
    {
      "name": "Active Navigation Link",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Marks the current section inside the grouped navigation rail.",
      "html": "<a class=\"ds-nav-link\" href=\"#/track/react\" aria-current=\"page\"><span>01</span>React</a>",
      "css": ".ds-nav-link { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: var(--radius-md); color: var(--accent); background: var(--accent-soft); font: 500 14px/1.4 var(--sans); text-decoration: none; } .ds-nav-link span { width: 22px; color: var(--muted); font: 12px/1 var(--mono); font-variant-numeric: tabular-nums; } .ds-nav-link:hover { background: var(--surface-2); text-decoration: none; } .ds-nav-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Shows one short grading or progress state.",
      "html": "<span class=\"ds-chip\">Đã hoàn thành</span>",
      "css": ".ds-chip { display: inline-flex; align-items: center; padding: 2px 9px; border-radius: var(--radius-pill); background: var(--ok-soft); color: var(--ok); font: 600 12px/1.4 var(--sans); }"
    },
    {
      "name": "Reading Container",
      "kind": "card",
      "refersTo": "reading-container",
      "description": "Separates an individual prompt or task from surrounding lesson text.",
      "html": "<article class=\"ds-reading\"><h3>Phần thực hành</h3><p>Đọc yêu cầu, thử làm bài, rồi xem phản hồi.</p></article>",
      "css": ".ds-reading { padding: 20px; border-radius: var(--radius-xl); background: var(--surface); color: var(--text); } .ds-reading h3 { margin: 0 0 8px; font: 700 1.1rem/1.2 var(--sans); } .ds-reading p { margin: 0; color: var(--muted); font: 400 16px/1.55 var(--sans); }"
